#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
root=$(CDPATH= cd -- "$script_dir/.." && pwd)
app="$root/build/Spender.app"

cd "$root"
swift build -c release --product Spender

case "$app" in
  "$root/build/Spender.app") ;;
  *) echo "invalid app output path" >&2; exit 1 ;;
esac
rm -rf "$app"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
cp "$root/.build/release/Spender" "$app/Contents/MacOS/Spender"
cp "$root/App/Info.plist" "$app/Contents/Info.plist"
xcrun actool \
    --compile "$app/Contents/Resources" \
    --platform macosx \
    --minimum-deployment-target 13.0 \
    --app-icon AppIcon \
    --output-partial-info-plist "$root/build/asset-info.plist" \
    "$root/App/Assets.xcassets"
rm "$root/build/asset-info.plist"
codesign --force --sign - --timestamp=none "$app"
codesign --verify --strict "$app"
echo "$app"
