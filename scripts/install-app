#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
root=$(CDPATH= cd -- "$script_dir/.." && pwd)
source_app=$("$root/scripts/build-app" | tail -1)
target_dir="$HOME/Applications"
target_app="$target_dir/Spender.app"

mkdir -p "$target_dir"
/usr/bin/osascript -e 'tell application id "com.blake.spender" to quit' >/dev/null 2>&1 || true
/usr/bin/ditto "$source_app" "$target_app"
codesign --verify --strict "$target_app"
open "$target_app"
echo "Installed and launched $target_app"
