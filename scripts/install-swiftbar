#!/bin/sh
set -eu

if [ "$#" -ne 1 ]; then
  echo "usage: $0 /path/to/SwiftBar/plugin-folder" >&2
  exit 2
fi

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
source_path="$script_dir/../swiftbar/spender.5m.py"
plugin_dir=$1
target_path="$plugin_dir/spender.5m.py"

mkdir -p "$plugin_dir"
if [ -e "$target_path" ] || [ -L "$target_path" ]; then
  echo "refusing to replace existing plugin: $target_path" >&2
  exit 1
fi

ln -s "$source_path" "$target_path"
echo "Installed Spender at $target_path"
